# --- Core ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Postgres ---
DATABASE_URL=postgresql+psycopg://pioneer:pioneer@localhost:5433/pioneer

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=pioneer_memories

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Dev-grade JWT secret. Rotate before any non-local use.
JWT_SECRET=change-me-in-prod-this-is-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

# --- Embeddings ---
# fastembed model id. BGE-small is fast + 384-dim.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- MCP server ---
# Workspace API key used by MCP clients (Claude Code, Cursor) to scope reads.
# Seed script creates a workspace and prints a matching key; paste it here.
MCP_API_KEY=dev-mcp-key-change-me

# --- Frontend ---
NEXT_PUBLIC_API_BASE=http://localhost:8001
API_PORT=8001

# --- Phase 2 ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=PASTE_FERNET_KEY_HERE
# Notion public OAuth integration (https://developers.notion.com/docs/authorization)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8001/connectors/notion/oauth/callback

# Gmail — Google Cloud Console → OAuth client (Web), scope: gmail.readonly
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8001/connectors/gmail/oauth/callback
GMAIL_MAX_MESSAGES=50

# GitHub — Settings → Developer settings → OAuth Apps, scope: repo,read:user
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8001/connectors/github/oauth/callback
GITHUB_MAX_REPOS=15
GITHUB_MAX_FILES_PER_REPO=20

FRONTEND_BASE=http://localhost:3000

# --- Phase 3 ---
# HMAC secret for the append-only audit chain. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
AUDIT_HMAC_KEY=PASTE_AUDIT_HMAC_KEY_HERE

# --- Phase 4 ---
# `stub` = templated answers, no API key needed (app boots cleanly in dev).
# Switch to anthropic or openai once a real key is set.
LLM_PROVIDER=stub          # stub | groq | anthropic | openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Groq (OpenAI-compatible). Comma-separate up to N keys; the provider
# auto-rotates to the next key when one hits a rate limit.
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Inbound message source for the automations runner.
AUTOMATIONS_INBOUND_PROVIDER=stub
DRAFTS_PER_RUN_MAX=25
